{
  "uid": "topup-journey",
  "title": "Nạp tiền — tìm hành trình theo topup_id / trace_id",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "tags": [
    "lab-23-02",
    "logging"
  ],
  "templating": {
    "list": [
      {
        "name": "topup_id",
        "label": "topup_id (chăm sóc khách hàng gửi)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "trace_id",
        "label": "trace_id (lấy từ dòng ở bảng trên)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Bước 1 — dòng có topup_id = $topup_id",
      "description": "Lọc chuỗi trước (nhanh), rồi parse JSON và so đúng trường topup_id. Mở một dòng, bấm trace_id để sang bước 2.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"gateway|topup|bank-adapter|ledger\"} |= \"$topup_id\" | json | topup_id=\"$topup_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Bước 2 — toàn bộ hành trình theo trace_id = $trace_id",
      "description": "trace_id là structured metadata (Collector đọc vào TraceId của bản ghi OTLP): lọc không cần | json. Gồm cả dòng của bank-adapter (sau hàng đợi BullMQ) vốn không có topup_id.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"gateway|topup|bank-adapter|ledger\"} | trace_id=\"$trace_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Dòng không parse được JSON",
      "description": "Mục tiêu 0: mọi service ghi theo schema chung.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"gateway|topup|bank-adapter|ledger\"} | json | __error__!=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dòng request/job thiếu trace_id",
      "description": "Mục tiêu 0.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"gateway|topup|bank-adapter|ledger\"} | json | event!=\"service.started\" | trace_id=\"\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dòng level error",
      "description": "Số dòng lỗi trong khoảng thời gian đang xem.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 20
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"gateway|topup|bank-adapter|ledger\"} | json | level=\"error\" [$__range]))",
          "queryType": "instant",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Số dòng log theo service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name) (count_over_time({service_name=~\"gateway|topup|bank-adapter|ledger\"} [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ]
    }
  ]
}
