# Chép thành .env trước khi chạy: `cp .env.example .env`. Compose đọc .env để nạp mật khẩu vào container, Vitest và
# script đo đọc .env để biết mật khẩu Grafana. GIÁ TRỊ DƯỚI CHỈ LÀ MẪU cho máy dev; không dùng ở môi trường thật.

# Grafana: tài khoản admin duy nhất; đăng nhập ẩn danh tắt (compose.yaml).
GRAFANA_ADMIN_PASSWORD=mau-doi-ngay-grafana

# [PATTERN] Cách 4 service ghi log: sau = logger JSON chung (pino, redact, trace_id); truoc = console.log tự do;
# off = như sau nhưng không ghi dòng nào (chỉ dùng khi đo overhead).
LOG_MODE=sau
