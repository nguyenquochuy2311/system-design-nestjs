{
  "name": "structured-logging-correlation-id-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 23/02: Structured Logging & Correlation ID — 4 service Fastify (gateway → topup → ledger, topup → BullMQ → bank-adapter → ledger) + Redis 7.4.6; gói packages/logging (pino: schema cố định, redact, trace_id/span_id từ OpenTelemetry context; traceparent qua job BullMQ); OTel Collector đọc stdout container (filelog) → Loki → Grafana",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "postinstall": "node scripts/build-services.mjs",
    "build": "node scripts/build-services.mjs",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose --profile bench down -v",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:incident": "tsx bench/incident-drill.ts",
    "bench:ingest": "tsx bench/ingest-latency.ts",
    "bench:overhead": "tsx bench/run-overhead.ts",
    "bench:negative": "tsx bench/negative-drills.ts",
    "bench:overhead-serial": "tsx bench/run-overhead-serial.ts"
  },
  "engines": {
    "node": ">=20.19 <21"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "bullmq": "6.3.8",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
