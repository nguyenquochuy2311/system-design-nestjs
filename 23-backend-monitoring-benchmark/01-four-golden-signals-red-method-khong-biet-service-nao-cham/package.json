{
  "name": "red-use-golden-signals-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 23/01: Four Golden Signals / RED / USE — 3 service Fastify (gateway → checkout → promotion) + PostgreSQL 16.15 + Toxiproxy; gói packages/observability dùng chung (OpenTelemetry SDK metrics) → OTel Collector → Prometheus (recording rules RED, alert) → Grafana; postgres_exporter cho USE của DB",
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "postinstall": "node scripts/build-services.mjs",
    "build": "node scripts/build-services.mjs",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:game-day": "tsx bench/game-day.ts",
    "bench:overhead": "tsx bench/run-overhead.ts",
    "bench:negative": "tsx bench/negative-drills.ts",
    "bench:series": "tsx bench/series-count.ts",
    "bench:overhead-serial": "tsx bench/run-overhead-serial.ts"
  },
  "engines": {
    "node": ">=20.19 <21"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
