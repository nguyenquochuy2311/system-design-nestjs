# Chép thành .env trước khi chạy: `cp .env.example .env`. Compose đọc .env để nạp mật khẩu vào container, Vitest và
# script đo đọc .env để biết mật khẩu Grafana. GIÁ TRỊ DƯỚI CHỈ LÀ MẪU cho máy dev; không dùng ở môi trường thật.

# Superuser khởi tạo của image postgres. Chỉ init script dùng.
POSTGRES_PASSWORD=mau-doi-ngay-superuser
# Role ứng dụng của checkout (đọc ghi đơn hàng) và role chỉ đọc số liệu cho postgres_exporter (pg_monitor).
SHOP_APP_PASSWORD=mau-doi-ngay-app
EXPORTER_PASSWORD=mau-doi-ngay-exporter

# Grafana: tài khoản admin duy nhất; đăng nhập ẩn danh tắt (compose.yaml).
GRAFANA_ADMIN_PASSWORD=mau-doi-ngay-grafana

# [PATTERN] Tắt toàn bộ instrumentation bằng biến chuẩn của OpenTelemetry (cùng code, dùng cho bản "trước" và đo overhead).
OTEL_SDK_DISABLED=false
