{
  "name": "saga-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 07/07: Saga orchestration — đặt hàng qua 3 service bằng HTTP và try/catch (trước) so với orchestrator lưu trạng thái, lệnh qua PGMQ, bước bù và hoàn tiền (sau) trên NestJS 10, PostgreSQL 16",
  "scripts": {
    "postinstall": "node scripts/build-services.mjs",
    "build": "node scripts/build-services.mjs",
    "db:up": "docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U postgres -d lab",
    "db:reset": "docker compose down -v",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:orders": "tsx bench/run-orders.ts",
    "bench:show": "node bench/show-results.mjs",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
