# Chép thành .env khi chạy tay; test và docker-compose.yml đã có sẵn giá trị này, chỉ dùng cho môi trường lab.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/lab
ORDER_DATABASE_URL=postgres://order_rw:order_rw@127.0.0.1:55432/lab
INVENTORY_DATABASE_URL=postgres://inventory_rw:inventory_rw@127.0.0.1:55432/lab
PAYMENT_DATABASE_URL=postgres://payment_rw:payment_rw@127.0.0.1:55432/lab
TRUOC_DATABASE_URL=postgres://truoc_rw:truoc_rw@127.0.0.1:55432/lab
# Hàng giữ quá chừng này giây mà saga chưa xong thì chốt với cổng rồi nhả hàng.
SAGA_DEADLINE_SECONDS=900
# Thời gian chờ cổng thanh toán (ms).
GATEWAY_TIMEOUT_MS=1000
