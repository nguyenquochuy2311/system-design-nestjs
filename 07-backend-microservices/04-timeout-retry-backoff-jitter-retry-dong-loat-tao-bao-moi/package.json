{
  "name": "timeout-retry-jitter-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 07/04: Timeouts, Retries, Backoff with Jitter — wallet gọi đối tác giả qua Toxiproxy, retry cố định không timeout (trước) so với timeout, retry có ngân sách, Full Jitter, Idempotency-Key (sau)",
  "scripts": {
    "postinstall": "node scripts/build-services.mjs",
    "build": "node scripts/build-services.mjs",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim:jitter": "tsx sim/jitter-simulation.ts",
    "bench:scenario": "tsx bench/run-scenario.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "cockatiel": "3.2.1",
    "fastify": "5.12.5",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
