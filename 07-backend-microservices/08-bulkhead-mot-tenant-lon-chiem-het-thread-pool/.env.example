# Chép thành .env khi chạy tay; test và docker-compose.yml đã có sẵn giá trị này, chỉ dùng cho môi trường lab.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/lab
DATABASE_URL=postgres://crm_app:crm_app@127.0.0.1:55432/lab
# truoc: một pool 20 kết nối cho mọi loại tải. sau: pool theo khoang, giới hạn theo tenant, xuất dữ liệu qua worker.
CRM_MODE=sau
# Thời gian giả định của một báo cáo hoặc lần xuất (giây).
REPORT_SECONDS=5
