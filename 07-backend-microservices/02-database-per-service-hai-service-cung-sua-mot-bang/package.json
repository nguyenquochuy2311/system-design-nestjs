{
  "name": "database-per-service-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 07/02: Database per Service — hai service chung bảng orders (trước) so với schema, role riêng và bản sao nuôi bằng sự kiện PGMQ (sau) trên NestJS 10, Kysely, PostgreSQL 16",
  "scripts": {
    "postinstall": "node scripts/build-services.mjs",
    "build": "node scripts/build-services.mjs",
    "db:up": "docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U postgres -d lab",
    "db:reset": "docker compose down -v",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:scenario": "tsx bench/run-scenario.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
