# Chép thành .env khi chạy tay; test và docker-compose.yml đã có sẵn giá trị này, chỉ dùng cho môi trường lab.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/lab
ORDER_DATABASE_URL=postgres://order_rw:order_rw@127.0.0.1:55432/lab
SHIPPING_DATABASE_URL=postgres://shipping_rw:shipping_rw@127.0.0.1:55432/lab
TRUOC_ORDER_DATABASE_URL=postgres://truoc_order:truoc_order@127.0.0.1:55432/lab
TRUOC_SHIPPING_DATABASE_URL=postgres://truoc_shipping:truoc_shipping@127.0.0.1:55432/lab
# Mô hình địa chỉ của shipping-service: single (cột address) hoặc split (street, ward, district, sau migration 002).
SHIPPING_ADDRESS_MODEL=single
# Chu kỳ shipping-service đọc hàng đợi sự kiện (ms).
ORDER_EVENT_POLL_MS=100
