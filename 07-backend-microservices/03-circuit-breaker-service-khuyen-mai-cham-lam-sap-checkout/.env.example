# Chép thành .env khi chạy tay; docker-compose.yml đã có sẵn giá trị mặc định này.
# truoc: gọi promotion chờ đủ 30 giây, không cầu dao. sau: timeout 2 giây, cầu dao, fallback.
CHECKOUT_MODE=sau
PROMOTION_URL=http://toxiproxy:18080
# Số kết nối tối đa tới promotion: tài nguyên hữu hạn mà sự cố làm cạn.
PROMOTION_POOL_SIZE=50
# Toxiproxy: API điều khiển.
TOXIPROXY_URL=http://127.0.0.1:58474
