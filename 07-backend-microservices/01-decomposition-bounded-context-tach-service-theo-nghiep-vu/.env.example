# Chép thành .env khi chạy tay; test và docker-compose.yml đã có sẵn giá trị này, chỉ dùng cho môi trường lab.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/lab
TRUOC_DATABASE_URL=postgres://truoc_app:truoc_app@127.0.0.1:55432/lab
CATALOG_DATABASE_URL=postgres://catalog_app:catalog_app@127.0.0.1:55432/lab
ORDERING_DATABASE_URL=postgres://ordering_app:ordering_app@127.0.0.1:55432/lab
INVENTORY_DATABASE_URL=postgres://inventory_app:inventory_app@127.0.0.1:55432/lab
PAYMENT_DATABASE_URL=postgres://payment_app:payment_app@127.0.0.1:55432/lab
# Phiên bản sự kiện Catalog phát ra: v1 hoặc v2 (v2 đổi tên trường, xem apps/catalog/published-event.ts).
CATALOG_EVENT_SCHEMA=v1
# Chu kỳ Ordering đọc hàng đợi sự kiện (ms).
CATALOG_EVENT_POLL_MS=200
