# API và job nền: tài khoản ứng dụng (không phải superuser), nối thẳng PostgreSQL
DATABASE_URL=postgres://contract_app:contract_app@localhost:55432/insurance
# Superuser cho migration, seed, test và đo (bật/tắt trigger, đọc pg_stat_statements)
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:55432/insurance
# Tài khoản script sửa dữ liệu (đường ghi thứ 3)
OPS_SCRIPT_DATABASE_URL=postgres://ops_script:ops_script@localhost:55432/insurance
# PgBouncer chế độ transaction (test người thực hiện không rò giữa các request)
PGBOUNCER_URL=postgres://contract_app:contract_app@localhost:56432/insurance
PORT=3100
LOG_LEVEL=warn
DB_POOL_MAX=10
