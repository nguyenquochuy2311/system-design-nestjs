# API (NestJS): SITE=sau ở 3100 (áp dụng pattern), SITE=truoc ở 3101 (hiện trạng)
SITE=sau
PORT=3100
# Bản API lúc khởi động; script deploy đổi qua POST /ops/release
RELEASE=41
# Chỉ dùng cho lab: khóa route /ops/release
OPS_TOKEN=lab-only-ops-token
# Mỗi request một dòng JSON, có X-App-Version (để trống = tắt); script đo tự đặt
REQUEST_LOG=
