{
  "name": "cache-busting-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 04/02: Cache Busting (tên file băm theo nội dung + immutable) cho SPA Vite + React: Nginx máy gốc tĩnh, Nginx proxy_cache làm CDN mô phỏng, API NestJS 10",
  "scripts": {
    "cdn:up": "docker compose up -d --wait",
    "cdn:down": "docker compose down -v",
    "api": "tsx src/main.ts",
    "site:build": "tsx scripts/build-release.ts",
    "site:deploy": "tsx scripts/deploy.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "bench:fleet": "tsx bench/fleet.ts",
    "bench:bytes": "tsx bench/redeploy-bytes.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.63.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
