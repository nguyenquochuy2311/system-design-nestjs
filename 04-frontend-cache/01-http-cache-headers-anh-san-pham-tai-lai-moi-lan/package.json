{
  "name": "http-caching-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 04/01: HTTP Caching (Cache-Control, ETag, Vary) cho trang danh mục: Next.js 16 (App Router), NestJS 10 (ảnh + JSON), Nginx proxy_cache làm CDN mô phỏng",
  "scripts": {
    "cdn:up": "docker compose up -d --wait",
    "cdn:down": "docker compose down -v",
    "media:seed": "tsx tools/generate-media.ts",
    "web:build": "NEXT_TELEMETRY_DISABLED=1 next build web",
    "api": "tsx src/main.ts",
    "web": "NEXT_TELEMETRY_DISABLED=1 tsx web/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "bench:bytes": "tsx bench/browser-bytes.ts",
    "bench:lcp": "tsx bench/lighthouse-lcp.ts",
    "bench:load": "tsx bench/run-load.ts",
    "bench:routes": "tsx bench/route-scan.ts",
    "bench:freshness": "tsx bench/price-freshness.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "chrome-launcher": "1.2.2",
    "lighthouse": "12.8.2",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
