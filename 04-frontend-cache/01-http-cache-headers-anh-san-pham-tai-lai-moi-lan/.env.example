# Bản đang chạy: truoc (mọi response no-store, không ETag) hoặc sau (chính sách theo loại tài nguyên)
CACHE_MODE=sau
# API + media-service (NestJS)
PORT=3100
# Trang (Next.js, custom server web/server.ts)
WEB_PORT=3200
# Chỉ dùng cho lab: ký cookie phiên `sid` và khóa route đổi giá
SESSION_SECRET=lab-only-session-secret
ADMIN_TOKEN=lab-only-admin-token
MEDIA_DIR=.data/media
# Ghi mỗi request tới máy chủ gốc một dòng JSON (để trống = tắt); script đo tự đặt
ACCESS_LOG=
