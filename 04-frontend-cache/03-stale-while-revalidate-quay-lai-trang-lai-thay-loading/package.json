{
  "name": "stale-while-revalidate-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 04/03: Stale-While-Revalidate phía client — Next.js 16 (App Router) + TanStack Query v5 cho màn Danh sách đơn, API NestJS 10 có độ trễ giả lập",
  "scripts": {
    "api": "tsx src/main.ts",
    "web:build": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build web",
    "web": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next start web --port 3200 --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "bench:back": "tsx bench/back-nav.ts",
    "bench:hour": "tsx bench/hour.ts",
    "bench:router": "tsx bench/router-cache-check.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@tanstack/react-query": "5.104.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
