# API (NestJS) — dùng chung cho bản trước và bản sau; pattern nằm ở phía client.
PORT=3100
# Độ trễ giả lập (ms): danh sách đơn là endpoint nặng nhất
LIST_LATENCY_MS=1200
DETAIL_LATENCY_MS=400
WRITE_LATENCY_MS=400
META_LATENCY_MS=200
# Hạt seed dữ liệu (900 đơn, 3 khu vực)
SEED=42
# Mỗi request một dòng JSON vào file này (để trống = chỉ giữ trong bộ nhớ, GET /ops/requests); script đo tự đặt
REQUEST_LOG=
