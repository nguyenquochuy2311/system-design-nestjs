# Chép thành .env trước khi chạy: `cp .env.example .env`. Compose đọc .env để nạp mật khẩu vào container,
# Vitest đọc .env để biết chuỗi kết nối. GIÁ TRỊ DƯỚI CHỈ LÀ MẪU cho dev/CI cục bộ; production lấy mật khẩu
# từ kho bí mật, không từ file này (bài 17/08).

# Superuser khởi tạo của image postgres (giống tài khoản master của DB được quản lý). Chỉ init script dùng.
POSTGRES_PASSWORD=mau-doi-ngay-superuser
# [PATTERN] Hai role như production: owner chạy migration (DDL), app chỉ đọc ghi dữ liệu (DML).
APP_OWNER_PASSWORD=mau-doi-ngay-owner
APP_USER_PASSWORD=mau-doi-ngay-app

# Ứng dụng kết nối bằng role app; migration kết nối bằng role owner. Mật khẩu trong URL phải khớp hai dòng trên.
DATABASE_URL=postgres://app_user:mau-doi-ngay-app@127.0.0.1:55432/crm
MIGRATION_DATABASE_URL=postgres://app_owner:mau-doi-ngay-owner@127.0.0.1:55432/crm

# Test dùng database riêng crm_test (init script tạo với cùng cấu hình quyền như crm).
TEST_DATABASE_URL=postgres://app_user:mau-doi-ngay-app@127.0.0.1:55432/crm_test
TEST_MIGRATION_DATABASE_URL=postgres://app_owner:mau-doi-ngay-owner@127.0.0.1:55432/crm_test

PORT=3100
