# Registry local (registry:2.8.3 trong docker-compose.yml); BuildKit của builder lab gọi qua mạng host của máy ảo Docker
REGISTRY_HOST=localhost:58500
# Image BuildKit cho builder docker-container của lab (cùng phiên bản BuildKit với builder desktop-linux)
BUILDKIT_IMAGE=moby/buildkit:v0.25.1@sha256:79cc6476ab1a3371c9afd8b44e7c55610057c43e18d9b39b68e2b0c2475cc1b6
