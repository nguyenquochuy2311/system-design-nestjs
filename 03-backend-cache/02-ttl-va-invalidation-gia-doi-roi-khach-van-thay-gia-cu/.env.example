DATABASE_URL=postgres://app:app@localhost:55432/shop
REDIS_URL=redis://127.0.0.1:56379
# Chờ Redis tối đa bao nhiêu ms trước khi bỏ qua cache và đọc DB (fail open, bài 03/01)
REDIS_COMMAND_TIMEOUT_MS=50
PORT=3100
# TTL của key trang (giây). Bản trước dùng đúng giá trị này, bản sau cộng/trừ PAGE_TTL_JITTER_PCT %.
PAGE_TTL_S=900
PAGE_TTL_JITTER_PCT=10
# Worker invalidation: chu kỳ đọc outbox (ms), số sự kiện mỗi lô, timeout lệnh Redis của worker (ms)
WORKER_POLL_MS=500
WORKER_BATCH=500
WORKER_REDIS_TIMEOUT_MS=500
# Job khuyến mãi: bản nào (truoc/sau) và chu kỳ quét lịch (ms)
VARIANT=sau
PROMO_TICK_MS=1000
# Chỉ dùng khi đo: id sản phẩm cần theo dõi và file ghi mỗi câu trả lời có chứa chúng
# WATCH_IDS=13,19,25
# WATCH_LOG=bench/results/trial/watch.ndjson
