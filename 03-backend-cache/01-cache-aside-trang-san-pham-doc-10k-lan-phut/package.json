{
  "name": "cache-aside-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 03/01: Cache-Aside cho trang sản phẩm trên NestJS 10, PostgreSQL 16 (pg_stat_statements), Redis 7 (ioredis)",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:seed": "docker compose exec -T postgres psql -U app -d catalog -v ON_ERROR_STOP=1 -v products=${PRODUCTS:-200000} -f /lab/db/seed.sql",
    "db:psql": "docker compose exec postgres psql -U app -d catalog",
    "db:reset": "docker compose down -v",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:drills": "tsx bench/negative-drills.ts",
    "bench:load": "tsx bench/run-load.ts",
    "bench:memory": "tsx bench/redis-memory.ts",
    "bench:rtt": "tsx bench/round-trip.ts",
    "bench:rounds": "tsx bench/latency-rounds.ts",
    "bench:stall": "tsx bench/event-loop-stall.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
