{
  "name": "contract-first-openapi-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 01/01: Contract-First API (OpenAPI 3.1) — spec sinh type/client cho web, Ajv kiểm request/response ở backend NestJS 10, Spectral lint, oasdiff chặn thay đổi phá vỡ",
  "scripts": {
    "api": "tsx apps/backend/src/main.ts",
    "mock": "prism mock --host 127.0.0.1 --port 3101 packages/api-contract/openapi.yaml",
    "contract:lint": "spectral lint packages/api-contract/openapi.yaml --ruleset packages/api-contract/.spectral.yaml --fail-severity warn",
    "contract:gen": "openapi-typescript packages/api-contract/openapi.yaml -o packages/api-contract/generated/schema.d.ts",
    "contract:diff": "tsx bench/oasdiff.ts",
    "contract:ci": "tsx bench/contract-ci.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:drills": "tsx bench/breaking-drills.ts",
    "bench:ci-time": "tsx bench/ci-timing.ts",
    "bench:negative": "tsx bench/negative-drills.ts",
    "bench:mock": "tsx bench/mock-start.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@stoplight/prism-cli": "5.14.2",
    "@stoplight/spectral-cli": "6.16.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
