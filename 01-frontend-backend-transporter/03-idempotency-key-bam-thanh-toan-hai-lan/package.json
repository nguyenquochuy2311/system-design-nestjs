{
  "name": "idempotency-key-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 01/03: Idempotency Key cho POST /payments trên NestJS 10 (interceptor), Kysely, PostgreSQL 16; Toxiproxy cắt response sau khi server commit",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U app -d wallet",
    "db:reset": "docker compose down -v",
    "dev": "tsx src/main.ts",
    "job:cleanup": "tsx src/sau/idempotency/run-cleanup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:cut": "tsx bench/run-response-cut.ts",
    "bench:concurrent": "tsx bench/run-concurrent.ts",
    "bench:overhead": "tsx bench/run-overhead.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
