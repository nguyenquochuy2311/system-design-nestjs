# Chép thành .env khi chạy tay; test không đọc file này.
DATABASE_URL=postgres://app:app@localhost:55432/wallet
PORT=3100
# Khóa đang "processing" quá thời gian này (ms) thì request sau được tiếp quản (tiến trình trước đã chết).
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
# Giữ khóa bao lâu (giờ) trước khi job dọn xóa; phải dài hơn cửa sổ retry lâu nhất của app.
IDEMPOTENCY_RETENTION_HOURS=24
# Chu kỳ chạy job dọn trong tiến trình API (ms); 0 = tắt, dùng `pnpm job:cleanup` theo lịch bên ngoài.
IDEMPOTENCY_CLEANUP_INTERVAL_MS=0
# Toxiproxy (bench): API điều khiển và cổng proxy tới API.
TOXIPROXY_URL=http://localhost:58474
PROXY_PORT=58401
