# Chép thành .env khi chạy tay; test không đọc file này (test tự đặt biến trong code).
DATABASE_URL=postgres://app:app@localhost:55432/accounts
REDIS_URL=redis://localhost:56379
PORT=3100

# Pepper: khóa bí mật NGOÀI database, trộn vào trước khi băm (tham số `secret` của Argon2).
# Lộ DB mà không lộ pepper thì hash vô dụng. GIÁ TRỊ DƯỚI CHỈ LÀ MẪU — sinh khóa ngẫu nhiên thật khi dùng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASSWORD_PEPPER=thay-bang-32-byte-ngau-nhien-base64

# Tham số Argon2id hiện hành (chọn bằng bench/hash-params.bench.ts trên máy đích). Hash cũ hơn các tham số
# này sẽ được băm lại khi người dùng đăng nhập (needsRehash). Giá trị dưới chọn trên máy lab (xem README 5.1):
# 64 MiB khớp "lựa chọn thứ hai" RFC 9106; p=1 cho dễ kiểm soát threadpool; t=5 để đạt ~100 ms trên máy này.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=5
ARGON2_PARALLELISM=1

# Bộ đếm đăng nhập sai (Redis): chặn sau bao nhiêu lần sai, trong cửa sổ bao lâu (giây).
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900

# Số luồng của libuv: giới hạn số hash Argon2id chạy song song (Argon2 tốn CPU, chạy trên threadpool).
UV_THREADPOOL_SIZE=4
