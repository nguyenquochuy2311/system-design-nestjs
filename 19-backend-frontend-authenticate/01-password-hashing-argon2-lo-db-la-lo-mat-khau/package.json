{
  "name": "password-hashing-argon2-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 19/01: Password Hashing Argon2id cho /login trên NestJS 10 (Kysely, PostgreSQL 16, Redis 7); seed MD5 không salt, script tấn công từ điển tổng hợp offline, nâng cấp hash khi đăng nhập",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U app -d accounts",
    "db:reset": "docker compose down -v",
    "db:seed": "tsx scripts/seed.ts",
    "migrate:wrap": "tsx scripts/migrate-wrap.ts",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench:params": "tsx bench/hash-params.bench.ts",
    "bench:crack": "tsx bench/crack-dictionary.ts",
    "bench:login": "tsx bench/run-login.ts",
    "bench:drills": "tsx bench/negative-drills.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@node-rs/argon2": "2.2.2",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
