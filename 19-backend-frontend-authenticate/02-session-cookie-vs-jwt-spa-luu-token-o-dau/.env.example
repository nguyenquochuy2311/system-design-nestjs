# Chép thành .env khi chạy tay (API/bench). Test KHÔNG đọc file này (test tự truyền CONFIG qua overrideProvider).
DATABASE_URL=postgres://app:app@localhost:55432/crm
REDIS_URL=redis://localhost:56379
PORT=3100

# Secret: KHÔNG có giá trị mặc định cứng trong mã chạy thật — thiếu là app ném khi khởi động.
# GIÁ TRỊ DƯỚI CHỈ LÀ MẪU; sinh ngẫu nhiên thật khi dùng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=thay-bang-32-byte-ngau-nhien-base64-cho-express-session
CSRF_SECRET=thay-bang-32-byte-ngau-nhien-base64-cho-hmac-csrf
JWT_SECRET=thay-bang-32-byte-ngau-nhien-base64-cho-jwt-hs256-ban-truoc

# Origin được phép gửi request đổi dữ liệu (kiểm tra Origin cho CSRF). Nhiều origin ngăn cách bằng dấu phẩy.
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

# Cookie phiên. __Host- buộc: Secure + Path=/ + KHÔNG Domain. COOKIE_SECURE=0 chỉ để gỡ lỗi (sẽ mất tiền tố __Host-).
COOKIE_NAME=__Host-sid
COOKIE_SECURE=1

# Hạn phiên (giây): nhàn rỗi (Redis TTL, gia hạn mỗi request) và tuyệt đối.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200

# Lab chạy http://localhost: báo cho express-session biết localhost là secure context để phát cookie Secure qua http.
# Chỉ áp cho request có Host localhost; mặc định TẮT khi không đặt biến. Bỏ đi nếu chạy sau TLS thật. Đã kiểm Chrome 154 chấp nhận cookie Secure/__Host- qua http://localhost (README 5.1).
TRUST_LOCALHOST_SECURE=1
