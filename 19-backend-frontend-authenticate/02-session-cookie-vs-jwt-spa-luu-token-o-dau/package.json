{
  "name": "session-cookie-vs-jwt-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lab bài 19/02: Session Cookie vs JWT — NestJS 10 (express-session + connect-redis, Redis 7, PostgreSQL 16) + Next.js 16.4 cùng origin; truoc JWT trong localStorage, sau session cookie __Host-sid + CSRF, so XSS/thu hồi/overhead",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:psql": "docker compose exec postgres psql -U app -d crm",
    "db:reset": "docker compose down -v",
    "db:seed": "tsx scripts/seed.ts",
    "api": "tsx src/main.ts",
    "web:build": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build web",
    "web": "NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next start web --port 3200 --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "bench:xss": "tsx bench/xss-browser.ts",
    "bench:login": "tsx bench/run-overhead.ts",
    "bench:drills": "tsx bench/negative-drills.ts",
    "zap:baseline": "tsx bench/zap-baseline.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "connect-redis": "7.1.1",
    "express": "4.21.2",
    "express-session": "1.18.1",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.2",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.25",
    "@types/express-session": "1.18.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
